{
  "name": "express-idempotency-guard",
  "version": "1.0.0",
  "description": "Express middleware for safe retries using idempotency keys, request fingerprints, response replay, and concurrency control.",
  "repository": {
    "type": "git",
    "url": "https://github.com/azmolwasimhussain-ops/express-idempotency-guard.git"
  },
  "bugs": {
    "url": "https://github.com/azmolwasimhussain-ops/express-idempotency-guard/issues"
  },
  "homepage": "https://github.com/azmolwasimhussain-ops/express-idempotency-guard#readme",
  "keywords": [
    "express",
    "idempotency",
    "middleware",
    "idempotency-key",
    "request-deduplication",
    "api"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "examples",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CODE_OF_CONDUCT.md"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "peerDependencies": {
    "express": "^4.18.0 || ^5.0.0"
  },
  "scripts": {
    "build": "tsup",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "pack": "npm pack --ignore-scripts",
    "pack:check": "npm pack --dry-run"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "express": "^4.22.1",
    "express5": "npm:express@^5.3.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.2",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
